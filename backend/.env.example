ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unisco
CORS_ORIGINS=["http://localhost:3000"]

# openssl rand -hex 32 로 생성 — 절대 커밋하지 말 것
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# resend.com 발급 API 키 (backend/README.md "이메일 발송" 참고)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=UniSco <onboarding@resend.dev>

# 카카오 로그인 — developers.kakao.com에서 앱 등록 후 발급(backend/README.md "카카오 로그인" 참고)
KAKAO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Client Secret 기능을 안 켰으면 빈 값으로 둘 것
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/login/kakao/callback
